/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# HTML: always revalidate — never serve a stale shell
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Catch-all for the SPA index (Netlify serves this for unknown paths)
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Vite hashes JS and CSS filenames (e.g. index-BxKj3a8f.js) — safe to cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts may not be hashed — use a conservative 1-week cache
*.woff2
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

*.woff
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Images and icons
*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
